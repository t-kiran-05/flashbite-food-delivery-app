# ==============================================================================
# FlashBite Multi-Tenant Ordering & Operational System — Environment Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env (e.g. `cp .env.example .env`)
# 2. Choose OPTION A (Cloud Services) or OPTION B (Local Docker)
# 3. DO NOT commit your live .env file to public version control!
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Security (Applies to both Options)
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# JWT Secret for User & Admin Authentication (Generate a strong 64-char string)
JWT_SECRET=flashbite_super_secret_jwt_key_change_in_production

# Frontend Origin for CORS (e.g., http://localhost:3000, https://flashbite.vercel.app)
CLIENT_URL=http://localhost:3000
FRONTEND_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# OPTION A: Cloud Setup (MongoDB Atlas + Upstash Redis + Aiven Kafka) [Default]
# ------------------------------------------------------------------------------
# MongoDB Atlas
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.mongodb.net/flashbite?retryWrites=true&w=majority

# Upstash Cloud Redis (TLS Enabled)
REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379
# Optional REST tokens (if utilizing serverless Redis REST endpoints):
# UPSTASH_REDIS_REST_URL=https://<host>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<your_token>

# Aiven / Confluent Cloud Kafka (SSL/TLS + SASL SCRAM-SHA-256)
KAFKA_BROKERS=your-aiven-kafka-host.aivencloud.com:24128
KAFKA_CLIENT_ID=flashbite-cloud-producer
KAFKA_SSL=true
KAFKA_SASL_USERNAME=avnadmin
KAFKA_SASL_PASSWORD=your_aiven_password
KAFKA_SASL_MECHANISM=scram-sha-256
# Optional CA Cert PEM (if needed for custom TLS validation):
# KAFKA_CA_CERT=

# ------------------------------------------------------------------------------
# OPTION B: Local Docker Setup (Full Local Stack via Docker Compose)
# ------------------------------------------------------------------------------
# Uncomment the block below if using local containerized services:
# MONGO_URI=mongodb://localhost:27017/flashbite
# REDIS_URI=redis://localhost:6379
# REDIS_URL=redis://localhost:6379
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=flashbite-local-producer
# KAFKA_SSL=false
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# ------------------------------------------------------------------------------
# Email / SMTP Configuration (for live Password Reset emails)
# ------------------------------------------------------------------------------
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_16_digit_app_password
#
# For Custom SMTP (SendGrid, Brevo, AWS SES, Resend):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_api_key
# EMAIL_FROM="FlashBite Support" <no-reply@flashbite.com>


# ------------------------------------------------------------------------------
# Google Gemini AI (Natural Language Craving Search)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here


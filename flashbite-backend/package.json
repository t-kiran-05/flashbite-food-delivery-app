{
  "name": "flashbite-ordering-system",
  "version": "2.0.0",
  "description": "FlashBite multi-tenant ordering & operational system — Node.js, Express, MongoDB, Kafka, Redis, Socket.IO",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon --watch src src/server.js",
    "seed:admin": "node src/scripts/seedAdmin.js",
    "seed:menu": "node src/scripts/seedMenu.js",
    "seed": "node src/scripts/seedAdmin.js && node src/scripts/seedMenu.js",
    "clear:orders": "node src/scripts/clearOrders.js"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@socket.io/redis-adapter": "^8.2.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.2",
    "connect-redis": "^7.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.17.3",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "kafkajs": "^2.2.4",
    "mongoose": "^7.5.0",
    "nodemailer": "^10.0.13",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "rate-limit-redis": "^4.2.0",
    "redis": "^4.7.0",
    "resend": "^6.31.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "keywords": [
    "food-delivery",
    "multi-tenant",
    "kafka",
    "redis",
    "socket.io"
  ],
